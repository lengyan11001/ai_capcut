# Supabase (recommended for persisting orders)
# Create a project at https://supabase.com and add the table (see README).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ASSET_BUCKET=product-media

# Admin CMS (MVP auth)
ADMIN_PANEL_PASSWORD=change-this-password
# Optional: if omitted, default session token is used
# ADMIN_SESSION_SECRET=replace-with-random-string

# Optional: use anon key with RLS instead of service role
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: send order notification email (future use)
# RESEND_API_KEY=re_xxx
# ORDER_NOTIFY_EMAIL=your@email.com

# Optional: manual crypto payment guide on thank-you page
# CRYPTO_PAY_COIN=USDT
# CRYPTO_PAY_NETWORK=TRON (TRC20)
# CRYPTO_PAY_ADDRESS=TXxxYourWalletAddress

# Optional: PayPal checkout (capture immediately)
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# PAYPAL_ENV=sandbox
# PAYPAL_BRAND_NAME=RealDollHub

# Optional: global support entry (SupportWidget)
# NEXT_PUBLIC_SUPPORT_WHATSAPP=14155551234
# NEXT_PUBLIC_SUPPORT_TELEGRAM=your_handle
# NEXT_PUBLIC_SUPPORT_INSTAGRAM=your_handle
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Optional: analytics
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# Public catalog: by default ALL published Supabase products show (no supplier whitelist).
# Set only if you want to hide non-MXJ lines:
# NEXT_PUBLIC_STOREFRONT_SUPPLIERS=mxj
# Optional bypass of that whitelist:
# NEXT_PUBLIC_SHOW_ALL_CATALOG=true

# Optional: geo and access control
# BLOCK_MAINLAND_CN=true
# ACCESS_BYPASS_KEY=replace-with-long-random-secret
# (Vercel: set on the doll-store-web project, then redeploy — middleware reads this on Edge.)
# Visit once: https://yoursite/?access_key=YOUR_KEY → 302 to / + httpOnly cookie site_access_bypass=1
# NEXT_PUBLIC_ENABLE_AGE_GATE=true

# Optional: supplier filter (OFF by default). Set ENABLE=true to restrict to CORE_SUPPLIERS; rows without specs.supplier still show.
# NEXT_PUBLIC_CORE_SUPPLIERS=mxj
# NEXT_PUBLIC_ENABLE_CORE_SUPPLIER_FILTER=true
