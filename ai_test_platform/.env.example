# 复制为 .env 后按需修改
# cp .env.example .env

# 必改：生产环境请使用随机字符串（如 openssl rand -hex 32）
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_IN_PRODUCTION

# 是否输出 500 详细错误（生产建议 false）
DEBUG=true

# 环境：dev / prod
ENVIRONMENT=dev

# 允许的跨域来源，逗号分隔
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 大模型（可选）：只配置了某一家时填写，前端只展示该厂商模型
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_PROVIDER=deepseek
# 可选值：deepseek / aliyun / volcengine

# OpenClaw Gateway（可选）：配置后「智能对话」将代理到 OpenClaw，由 OpenClaw 调用 MCP
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=你的gateway-token

# 新用户注册赠送积分（默认 30，可调高/调低控制成本）
# DEFAULT_CREDITS_FOR_NEW_USER=30

# 充值接口密钥：POST /auth/recharge 时请求头 X-Recharge-Token 需与此一致
# RECHARGE_SECRET=你的充值密钥

# 智能对话用量限制（防过度使用；0 表示不限制，前期内部用可放宽）
# CHAT_DAILY_CAP_PER_USER=100
# CHAT_RATE_LIMIT_PER_MINUTE=30
