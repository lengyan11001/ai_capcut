# 复制为 .env 后按需修改
# cp .env.example .env

# 必改：生产环境请使用随机字符串（如 openssl rand -hex 32）
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_IN_PRODUCTION

# 是否输出 500 详细错误（生产建议 false）
DEBUG=true

# 环境：dev / prod
ENVIRONMENT=dev

# 允许的跨域来源，逗号分隔
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 大模型（可选）：只配置了某一家时填写，前端只展示该厂商模型
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_PROVIDER=deepseek
# 可选值：deepseek / aliyun / volcengine

# OpenClaw 双实例（可选）：管理员一套 + 普通用户一套，完全分开
# 管理员实例（原单实例，仅下面白名单账号会连这台）
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=你的gateway-token
# 用户实例（其它所有用户只连这台，端口需不同，如 18790）
# OPENCLAW_GATEWAY_URL_USERS=http://127.0.0.1:18790
# OPENCLAW_GATEWAY_TOKEN_USERS=用户实例的gateway-token
# 管理员名单：逗号分隔 user id 或 email，例如 1 或 admin@example.com
# OPENCLAW_LEARN_ALLOWLIST=1
# 排障用：true=白名单也改走用户实例（平时不要开）
# OPENCLAW_LEARN_ALLOWLIST_USE_USERS_GATEWAY=

# 新用户注册赠送积分（默认 30，可调高/调低控制成本）
# DEFAULT_CREDITS_FOR_NEW_USER=30

# 充值接口密钥：POST /auth/recharge 时请求头 X-Recharge-Token 需与此一致
# RECHARGE_SECRET=你的充值密钥

# 智能对话用量限制（防过度使用；0 表示不限制，前期内部用可放宽）
# CHAT_DAILY_CAP_PER_USER=100
# CHAT_RATE_LIMIT_PER_MINUTE=30

# 养号计划 LLM（直接调用 OpenAI 兼容端点，优先级高于 OpenClaw 网关；不配则只走 OpenClaw）
# NURTURE_LLM_BASE_URL=https://api.ephone.chat/v1
# NURTURE_LLM_API_KEY=sk-xxx
# NURTURE_LLM_MODEL=deepseek-chat

# 群控 Agent 鉴权（建议生产必配）
# CONTROL_AGENT_SECRET=change_me_for_local_agent
# CONTROL_TASK_LEASE_SECONDS=120
# CONTROL_AGENT_OFFLINE_SECONDS=90

# Reddit 评论转视频后端（平台异步任务调用时使用；不配则无法提交任务）
# REDDIT_COMMENT2VIDEO_BACKEND_URL=http://127.0.0.1:8003
